<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodeViewer.ViewModels"
        xmlns:views="using:CodeViewer.Views"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:models="using:CodeViewer.Models"
        x:Class="CodeViewer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/icon.ico"
        Width="1120" Height="740"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeWindowBackground}"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="FlyoutPresenter.language-flyout">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
      <Setter Property="Background" Value="{DynamicResource ThemeMenuBackground}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="MinWidth" Value="240"/>
      <Setter Property="MaxWidth" Value="260"/>
      <Setter Property="MaxHeight" Value="400"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="Button.active-lang">
      <Setter Property="Background" Value="{DynamicResource ThemeSelectionBackground}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Styles>

  <Window.KeyBindings>
    <!-- File Operation Shortcuts -->
    <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNewDocumentCommand}"/>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}"/>
    <KeyBinding Gesture="Ctrl+P" Command="{Binding ShowQuickOpenCommand}"/>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyAllCommand}"/>
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" CommandParameter="{Binding ActiveDocument}"/>

    <!-- Search & Replace Shortcuts -->
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ShowSearchCommand}"/>
    <KeyBinding Gesture="Ctrl+H" Command="{Binding ShowReplaceCommand}"/>
    <KeyBinding Gesture="Ctrl+G" Command="{Binding ShowGoToLineCommand}"/>
    <KeyBinding Gesture="F3" Command="{Binding SearchViewModel.FindNextCommand}"/>
    <KeyBinding Gesture="Shift+F3" Command="{Binding SearchViewModel.FindPreviousCommand}"/>

    <!-- Code Editing Shortcuts -->
    <KeyBinding Gesture="Ctrl+OemQuestion" Command="{Binding ToggleCommentCommand}"/>
    <KeyBinding Gesture="Ctrl+Divide" Command="{Binding ToggleCommentCommand}"/>

    <!-- View & Zoom Shortcuts -->
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}"/>
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}"/>
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}"/>
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}"/>
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ResetZoomCommand}"/>
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ResetZoomCommand}"/>
    <KeyBinding Gesture="Alt+Z" Command="{Binding ToggleWordWrapCommand}"/>

    <!-- Settings Shortcut -->
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding ShowSettingsCommand}"/>
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*">
    <!-- Top Menu Bar -->
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_New File" Command="{Binding CreateNewDocumentCommand}" HotKey="Ctrl+N" InputGesture="Ctrl+N"/>
        <MenuItem Header="_Open File..." Command="{Binding OpenFileCommand}" HotKey="Ctrl+O" InputGesture="Ctrl+O"/>
        <MenuItem Header="Quick _Open..." Command="{Binding ShowQuickOpenCommand}" HotKey="Ctrl+P" InputGesture="Ctrl+P"/>
        <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding HasRecentFiles}">
          <MenuItem.Styles>
            <Style Selector="MenuItem > MenuItem" x:DataType="models:RecentFileItem">
              <Setter Property="Header" Value="{Binding FileName}"/>
              <Setter Property="ToolTip.Tip" Value="{Binding FilePath}"/>
              <Setter Property="Command" Value="{Binding OpenCommand}"/>
              <Setter Property="CommandParameter" Value="{Binding FilePath}"/>
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <MenuItem Header="Clear Recent History" Command="{Binding ClearRecentFilesCommand}" IsEnabled="{Binding HasRecentFiles}"/>
        <Separator/>
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" HotKey="Ctrl+S" InputGesture="Ctrl+S"/>
        <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" HotKey="Ctrl+Shift+S" InputGesture="Ctrl+Shift+S"/>
        <MenuItem Header="_Close Tab" Command="{Binding CloseTabCommand}" CommandParameter="{Binding ActiveDocument}" HotKey="Ctrl+W" InputGesture="Ctrl+W"/>
        <Separator/>
        <MenuItem Header="_Settings..." Command="{Binding ShowSettingsCommand}" HotKey="Ctrl+OemComma"/>
        <MenuItem Header="File _Info..." Click="OnShowFileInfoClick"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="OnExitClick" InputGesture="Alt+F4"/>
      </MenuItem>

      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Click="OnUndoClick" HotKey="Ctrl+Z" InputGesture="Ctrl+Z"/>
        <MenuItem Header="_Redo" Click="OnRedoClick" HotKey="Ctrl+Y" InputGesture="Ctrl+Y"/>
        <Separator/>
        <MenuItem Header="Cu_t" Click="OnCutClick" HotKey="Ctrl+X" InputGesture="Ctrl+X"/>
        <MenuItem Header="_Copy" Click="OnCopyClick" HotKey="Ctrl+C" InputGesture="Ctrl+C"/>
        <MenuItem Header="Copy _All" Command="{Binding CopyAllCommand}" HotKey="Ctrl+Shift+C" InputGesture="Ctrl+Shift+C"/>
        <MenuItem Header="_Paste" Click="OnPasteClick" HotKey="Ctrl+V" InputGesture="Ctrl+V"/>
        <MenuItem Header="Select _All" Click="OnSelectAllClick" HotKey="Ctrl+A" InputGesture="Ctrl+A"/>
        <Separator/>
        <MenuItem Header="_Find..." Command="{Binding ShowSearchCommand}" HotKey="Ctrl+F" InputGesture="Ctrl+F"/>
        <MenuItem Header="_Replace..." Command="{Binding ShowReplaceCommand}" HotKey="Ctrl+H" InputGesture="Ctrl+H"/>
        <MenuItem Header="Go to _Line..." Command="{Binding ShowGoToLineCommand}" HotKey="Ctrl+G" InputGesture="Ctrl+G"/>
        <Separator/>
        <MenuItem Header="Toggle _Line Comment" Command="{Binding ToggleCommentCommand}" HotKey="Ctrl+OemQuestion"/>
        <MenuItem Header="_Duplicate Line / Selection" Click="OnDuplicateLineClick" HotKey="Ctrl+D" InputGesture="Ctrl+D"/>
        <MenuItem Header="_Delete Line" Click="OnDeleteLineClick" HotKey="Ctrl+Shift+K" InputGesture="Ctrl+Shift+K"/>
        <Separator/>
        <MenuItem Header="_Settings..." Command="{Binding ShowSettingsCommand}" HotKey="Ctrl+OemComma"/>
      </MenuItem>

      <MenuItem Header="_View">
        <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" HotKey="Ctrl+OemPlus"/>
        <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" HotKey="Ctrl+OemMinus"/>
        <MenuItem Header="_Reset Zoom" Command="{Binding ResetZoomCommand}" HotKey="Ctrl+D0"/>
        <Separator/>
        <MenuItem Header="Toggle _Word Wrap" Command="{Binding ToggleWordWrapCommand}" HotKey="Alt+Z" InputGesture="Alt+Z">
          <MenuItem.Icon>
            <TextBlock Text="✓" FontWeight="Bold" IsVisible="{Binding ActiveDocument.WordWrap, FallbackValue=False}"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Toggle _Line Numbers" Command="{Binding ToggleLineNumbersCommand}"/>
      </MenuItem>

      <!-- Theme Switcher & Importer Menu -->
      <MenuItem Header="_Themes">
        <MenuItem Header="Dark+ (VS Code)" Click="OnSelectThemeMenuClick" Tag="dark-plus"/>
        <MenuItem Header="One Dark Pro" Click="OnSelectThemeMenuClick" Tag="one-dark"/>
        <MenuItem Header="Monokai" Click="OnSelectThemeMenuClick" Tag="monokai"/>
        <MenuItem Header="Dracula" Click="OnSelectThemeMenuClick" Tag="dracula"/>
        <MenuItem Header="Solarized Dark" Click="OnSelectThemeMenuClick" Tag="solarized-dark"/>
        <MenuItem Header="GitHub Light" Click="OnSelectThemeMenuClick" Tag="github-light"/>
        <Separator/>
        <MenuItem Header="Import _Color Theme (.json)..." Command="{Binding ImportThemeCommand}"/>
        <MenuItem Header="Import _Syntax Definition (.xshd)..." Command="{Binding ImportSyntaxCommand}"/>
        <Separator/>
        <MenuItem Header="Open _Themes Folder" Command="{Binding OpenThemesFolderCommand}"/>
      </MenuItem>

      <!-- Developer Tools & Plugins Menu -->
      <MenuItem Header="_Tools">
        <MenuItem Header="_JSON Tools">
          <MenuItem Header="_Format JSON (2 spaces)" Click="OnJsonFormatClick"/>
          <MenuItem Header="_Minify JSON" Click="OnJsonMinifyClick"/>
        </MenuItem>
        <MenuItem Header="_Line Utilities">
          <MenuItem Header="Sort Lines (_A to Z)" Click="OnSortAscClick"/>
          <MenuItem Header="Sort Lines (_Z to A)" Click="OnSortDescClick"/>
          <MenuItem Header="_Remove Duplicate Lines" Click="OnRemoveDuplicatesClick"/>
          <MenuItem Header="Re_verse Lines" Click="OnReverseLinesClick"/>
        </MenuItem>
        <MenuItem Header="_Encodings">
          <MenuItem Header="_Base64 Encode" Click="OnBase64EncodeClick"/>
          <MenuItem Header="Base64 _Decode" Click="OnBase64DecodeClick"/>
          <MenuItem Header="_URL Encode" Click="OnUrlEncodeClick"/>
          <MenuItem Header="URL D_ecode" Click="OnUrlDecodeClick"/>
        </MenuItem>
        <MenuItem Header="_Case Transform">
          <MenuItem Header="UPPERCASE" Click="OnUpperCaseClick"/>
          <MenuItem Header="lowercase" Click="OnLowerCaseClick"/>
          <MenuItem Header="Title Case" Click="OnTitleCaseClick"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Text _Statistics..." Click="OnTextStatisticsClick"/>
        <Separator/>
        <MenuItem Header="_Import Plugin (.dll)..." Command="{Binding ImportPluginCommand}"/>
        <MenuItem Header="_Open Plugins Folder" Command="{Binding OpenPluginsFolderCommand}"/>
        <MenuItem Header="_Plugin Manager..." Command="{Binding ShowPluginManagerCommand}"/>
      </MenuItem>

      <MenuItem Header="_Help">
        <MenuItem Header="_About Code Viewer" Click="OnAboutClick"/>
        <MenuItem Header="Check Language &amp; Integration _Updates..." Command="{Binding CheckIntegrationsUpdateCommand}"/>
        <MenuItem Header="_GitHub Repository" Click="OnGitHubRepoClick"/>
      </MenuItem>
    </Menu>

    <!-- Main Editor Workspace -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
      <!-- Tab Bar Area with Modern Rounded Corners -->
      <Border x:Name="TabBarBorder" Grid.Row="0" Background="{DynamicResource ThemeTabBarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="4,4,4,0" DoubleTapped="OnTabBarDoubleTapped">
        <Grid ColumnDefinitions="*,Auto">
          <!-- Tabs Strip -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Documents}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="2"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:DocumentViewModel">
                  <Border Margin="0,0,2,0"
                          Padding="14,6,8,6"
                          CornerRadius="6,6,0,0"
                          Cursor="Hand"
                          Classes.tabActive="{Binding IsActive}"
                          Classes.tabInactive="{Binding !IsActive}"
                          PointerPressed="OnTabPointerPressed">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Close Tab"
                                  Command="{Binding ((vm:MainViewModel)DataContext).CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  InputGesture="Ctrl+W"/>
                        <MenuItem Header="Close Other Tabs"
                                  Command="{Binding ((vm:MainViewModel)DataContext).CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Close Tabs to the Right"
                                  Command="{Binding ((vm:MainViewModel)DataContext).CloseTabsToTheRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Close Saved Tabs"
                                  Command="{Binding ((vm:MainViewModel)DataContext).CloseSavedTabsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Separator/>
                        <MenuItem Header="Copy Full Path"
                                  Command="{Binding ((vm:MainViewModel)DataContext).CopyDocumentPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Reveal in File Explorer"
                                  Command="{Binding ((vm:MainViewModel)DataContext).RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontSize="12"
                                 VerticalAlignment="Center"/>
                      <Button ToolTip.Tip="Close Tab (Ctrl+W)"
                              Width="18" Height="18"
                              Padding="0"
                              CornerRadius="9"
                              Background="Transparent"
                              BorderThickness="0"
                              Command="{Binding ((vm:MainViewModel)DataContext).CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="✕"
                                   FontSize="9"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Tab Bar Action Buttons: Copy All & New Tab -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Command="{Binding CopyAllCommand}"
                    ToolTip.Tip="Copy All Content to Clipboard (Ctrl+Shift+C)"
                    Padding="6,3"
                    CornerRadius="4"
                    Margin="2,1"
                    Background="Transparent"
                    BorderThickness="0">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="📋" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Copy All" FontSize="11" Foreground="{DynamicResource ThemeMenuForeground}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Command="{Binding CreateNewDocumentCommand}"
                    ToolTip.Tip="New Tab (Ctrl+N)"
                    Width="28" Height="26"
                    Padding="0"
                    CornerRadius="5"
                    Margin="2,1,4,1"
                    Background="Transparent"
                    BorderThickness="0">
              <TextBlock Text="+"
                         FontSize="16"
                         Foreground="{DynamicResource ThemeMenuForeground}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Editor Viewport with Floating Search Overlay and Command Palettes -->
      <Grid Grid.Row="1">
        <ae:TextEditor x:Name="Editor"
                       Document="{Binding ActiveDocument.TextDocument}"
                       SyntaxHighlighting="{Binding ActiveDocument.HighlightingDefinition}"
                       FontSize="{Binding ActiveDocument.FontSize, FallbackValue=14.0}"
                       WordWrap="{Binding ActiveDocument.WordWrap, FallbackValue=False}"
                       ShowLineNumbers="{Binding ActiveDocument.ShowLineNumbers, FallbackValue=True}"
                       FontFamily="{Binding CurrentFontFamily}"
                       Background="{DynamicResource ThemeEditorBackground}"
                       Foreground="{DynamicResource ThemeEditorForeground}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Visible"
                       LineNumbersForeground="{DynamicResource ThemeLineNumbersForeground}"
                       DragDrop.AllowDrop="True"/>

        <!-- Quick Open Palette (Ctrl+P) -->
        <Border IsVisible="{Binding IsQuickOpenOpen}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Width="520"
                MaxHeight="380"
                Background="{DynamicResource ThemeMenuBackground}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 8 24 #66000000"
                ZIndex="100">
          <Grid RowDefinitions="Auto,*">
            <TextBox x:Name="QuickOpenTextBox"
                     Grid.Row="0"
                     Text="{Binding QuickOpenQuery, Mode=TwoWay}"
                     Watermark="Type file or tab name to open (Esc to close)..."
                     Margin="8,8,8,6"
                     CornerRadius="4"
                     KeyDown="OnQuickOpenTextBoxKeyDown"/>
            <ListBox x:Name="QuickOpenListBox"
                     Grid.Row="1"
                     ItemsSource="{Binding FilteredQuickOpenItems}"
                     SelectedItem="{Binding SelectedQuickOpenItem, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="300"
                     DoubleTapped="OnQuickOpenItemDoubleTapped"
                     KeyDown="OnQuickOpenListBoxKeyDown">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="models:QuickOpenItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                    <StackPanel Grid.Column="0" Orientation="Vertical">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeWindowForeground}"/>
                      <TextBlock Text="{Binding RelativeOrFullPath}" FontSize="11" Foreground="{DynamicResource ThemeStatusBarForeground}" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TabBadge}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeAccentBrush}"
                               Opacity="0.85"
                               Margin="8,0,0,0"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- Go to Line Palette (Ctrl+G) -->
        <Border IsVisible="{Binding IsGoToLineOpen}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Width="320"
                Background="{DynamicResource ThemeMenuBackground}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 8 24 #66000000"
                Padding="8"
                ZIndex="100">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="GoToLineTextBox"
                     Grid.Column="0"
                     Text="{Binding GoToLineInput, Mode=TwoWay}"
                     Watermark="{Binding GoToLineWatermark}"
                     CornerRadius="4"
                     KeyDown="OnGoToLineTextBoxKeyDown"/>
            <Button Grid.Column="1"
                    Command="{Binding ExecuteGoToLineCommand}"
                    Content="Go"
                    Margin="6,0,0,0"
                    Padding="12,4"
                    CornerRadius="4"/>
          </Grid>
        </Border>

        <!-- Search & Replace Overlay (Floating on top right) with Modern Rounded Corners -->
        <views:SearchOverlayView DataContext="{Binding SearchViewModel}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,12,24,0"/>
      </Grid>

      <!-- Modern Status Bar -->
      <Border x:Name="StatusBarBorder" Grid.Row="2" Classes="statusbar" Background="{DynamicResource ThemeStatusBarBackground}" Height="24">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- Left Info: Language Selector | Encoding | Line Endings -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <!-- Clickable Manual Language Selector -->
            <Button x:Name="LanguageButton"
                    ToolTip.Tip="Select Language Mode"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,1"
                    CornerRadius="3"
                    Cursor="Hand">
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedLeft"
                        FlyoutPresenterClasses="language-flyout">
                  <Grid RowDefinitions="Auto,*,Auto" MaxHeight="380" Width="240">
                    <!-- Search Header -->
                    <Border Grid.Row="0"
                            Padding="8,8,8,6"
                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="0,0,0,1">
                      <TextBox x:Name="LanguageSearchBox"
                               Text="{Binding LanguageFilter, Mode=TwoWay}"
                               Watermark="Search language..."
                               FontSize="12"
                               Padding="6,4"
                               KeyDown="OnLanguageSearchKeyDown"
                               CornerRadius="4"/>
                    </Border>

                    <!-- Language List -->
                    <ScrollViewer Grid.Row="1"
                                  x:Name="LanguageScrollViewer"
                                  MaxHeight="290"
                                  VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding FilteredLanguageOptions}"
                                    Padding="4,4">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:LanguageOption">
                            <Button Click="OnLanguageItemClick"
                                    Command="{Binding ((vm:MainViewModel)DataContext).SetLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Name}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,5"
                                    Margin="0,1"
                                    CornerRadius="4"
                                    FontSize="12"
                                    Foreground="{DynamicResource ThemeWindowForeground}"
                                    Classes.active-lang="{Binding IsSelected}">
                              <Grid ColumnDefinitions="20,*">
                                <TextBlock Grid.Column="0"
                                           Text="✓"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           IsVisible="{Binding IsSelected}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"/>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer: Updates check & status -->
                    <Border Grid.Row="2"
                            Padding="8,6"
                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Background="{DynamicResource ThemeTabBarBackground}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="Language Mode"
                                   FontSize="11"
                                   Opacity="0.7"
                                   Foreground="{DynamicResource ThemeStatusBarForeground}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Check Updates 🔄"
                                Command="{Binding CheckIntegrationsUpdateCommand}"
                                Click="OnLanguageItemClick"
                                FontSize="10"
                                Padding="6,2"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource ThemeAccentBrush}"
                                Cursor="Hand"/>
                      </Grid>
                    </Border>
                  </Grid>
                </Flyout>
              </Button.Flyout>
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="statusitem" Text="{Binding ActiveDocument.Language, FallbackValue='Plain Text'}"/>
                <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource ThemeStatusBarForeground}" Opacity="0.8"/>
              </StackPanel>
            </Button>
            <TextBlock Text="|" Foreground="{DynamicResource ThemeStatusBarForeground}" Opacity="0.6" VerticalAlignment="Center" FontSize="11"/>
            <TextBlock Classes="statusitem" Text="{Binding ActiveDocument.EncodingName, FallbackValue='UTF-8'}"/>
            <TextBlock Text="|" Foreground="{DynamicResource ThemeStatusBarForeground}" Opacity="0.6" VerticalAlignment="Center" FontSize="11"/>
            <TextBlock Classes="statusitem" Text="{Binding ActiveDocument.LineEndingDisplay, FallbackValue='LF'}"/>
          </StackPanel>

          <!-- Center Notification / Temporary Status Message -->
          <TextBlock Grid.Column="1"
                     Text="{Binding StatusMessage}"
                     Foreground="{DynamicResource ThemeStatusBarForeground}"
                     FontSize="11"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Opacity="0.95"/>

          <!-- Right Info: Caret Position, Font Size, and Settings Button -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Classes="statusitem" Text="{Binding ActiveDocument.CaretDisplay, FallbackValue='Ln 1, Col 1'}"/>
            <TextBlock Text="|" Foreground="{DynamicResource ThemeStatusBarForeground}" Opacity="0.6" VerticalAlignment="Center" FontSize="11"/>
            <TextBlock Classes="statusitem" Text="{Binding ActiveDocument.FontSize, StringFormat='{}{0:0} pt', FallbackValue='14 pt'}"/>
            <TextBlock Text="|" Foreground="{DynamicResource ThemeStatusBarForeground}" Opacity="0.6" VerticalAlignment="Center" FontSize="11"/>
            <Button Command="{Binding ShowSettingsCommand}"
                    ToolTip.Tip="Settings (Ctrl+,)"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,1"
                    CornerRadius="3"
                    Cursor="Hand">
              <TextBlock Text="⚙" FontSize="12" Foreground="{DynamicResource ThemeStatusBarForeground}"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
