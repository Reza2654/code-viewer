<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodeViewer.ViewModels"
        xmlns:models="using:CodeViewer.Models"
        x:Class="CodeViewer.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="Settings &amp; Preferences - Code Viewer"
        Icon="/Assets/icon.png"
        Width="780" Height="640"
        MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBackground}">

  <Window.Styles>
    <Style Selector="Button.segmented">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#888888"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.segmented:pointerover">
      <Setter Property="Background" Value="#2E2E32"/>
      <Setter Property="Foreground" Value="#CCCCCC"/>
    </Style>
    <Style Selector="Button.segmented.active">
      <Setter Property="Background" Value="#3F3F46"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button.segmented-text">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#888888"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.segmented-text:pointerover">
      <Setter Property="Background" Value="#2E2E32"/>
      <Setter Property="Foreground" Value="#CCCCCC"/>
    </Style>
    <Style Selector="Button.segmented-text.active">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.settings-card">
      <Setter Property="Background" Value="{DynamicResource ThemeTabBarBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>

    <Style Selector="Button.theme-card-btn">
      <Setter Property="Background" Value="{DynamicResource ThemeTabBarBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Width" Value="220"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.theme-card-btn:pointerover">
      <Setter Property="Background" Value="#2A2A30"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
    </Style>
  </Window.Styles>

  <Grid Margin="22" RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Settings &amp; Preferences"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource ThemeWindowForeground}"/>
        <TextBlock Text="Customize coding fonts, developer themes, syntax token colors, and editor behavior."
                   FontSize="12"
                   Foreground="#888888"
                   Margin="0,4,0,0"/>
      </StackPanel>
      <Border Grid.Column="1"
              Background="{DynamicResource ThemeTabBarBackground}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10,4"
              VerticalAlignment="Center">
        <TextBlock Text="v1.2.0-beta.13"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ThemeAccentBrush}"/>
      </Border>
    </Grid>

    <!-- Tabbed Settings Content -->
    <TabControl Grid.Row="1">
      <!-- ========================================== -->
      <!-- TAB 1: Editor & Fonts                      -->
      <!-- ========================================== -->
      <TabItem Header="🔤 Editor &amp; Fonts">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="4,12,8,12">
            <!-- 1. Font Family Card -->
            <Border Classes="settings-card">
              <StackPanel Spacing="10">
                <TextBlock Text="Coding Font Family"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeWindowForeground}"
                           FontSize="14"/>
                <TextBlock Text="Select a coding font or type any custom font installed on your operating system."
                           FontSize="11"
                           Foreground="#888888"/>

                <!-- Quick Preset Font Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,4">
                  <Button Content="Google Sans Code"
                          Command="{Binding SelectPrimaryFontCommand}"
                          CommandParameter="Google Sans Code"
                          Classes="segmented-text"
                          Background="#252528"
                          Foreground="{DynamicResource ThemeWindowForeground}"
                          Padding="10,5"/>
                  <Button Content="Roboto Mono"
                          Command="{Binding SelectPrimaryFontCommand}"
                          CommandParameter="Roboto Mono"
                          Classes="segmented-text"
                          Background="#252528"
                          Foreground="{DynamicResource ThemeWindowForeground}"
                          Padding="10,5"/>
                  <Button Content="Cascadia Code"
                          Command="{Binding SelectPrimaryFontCommand}"
                          CommandParameter="Cascadia Code"
                          Classes="segmented-text"
                          Background="#252528"
                          Foreground="{DynamicResource ThemeWindowForeground}"
                          Padding="10,5"/>
                  <Button Content="Consolas"
                          Command="{Binding SelectPrimaryFontCommand}"
                          CommandParameter="Consolas"
                          Classes="segmented-text"
                          Background="#252528"
                          Foreground="{DynamicResource ThemeWindowForeground}"
                          Padding="10,5"/>
                </StackPanel>

                <!-- Editable Font Selector ComboBox -->
                <ComboBox ItemsSource="{Binding AvailableFonts}"
                          SelectedItem="{Binding SelectedFont}"
                          HorizontalAlignment="Stretch"
                          MaxDropDownHeight="240"/>
              </StackPanel>
            </Border>

            <!-- 2. Font Size & Tab Size Card -->
            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,16,*">
                <!-- Left: Font Size -->
                <StackPanel Grid.Column="0" Spacing="8">
                  <TextBlock Text="Font Size"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ThemeWindowForeground}"
                             FontSize="13"/>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="−"
                            Command="{Binding DecreaseFontSizeCommand}"
                            Classes="segmented-text"
                            Background="#252528"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            FontWeight="Bold"
                            Padding="12,4"/>
                    <Button Content="12"
                            Command="{Binding SetFontSizeCommand}"
                            CommandParameter="12"
                            Classes="segmented-text"
                            Background="#252528"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Padding="8,4"/>
                    <Button Content="14"
                            Command="{Binding SetFontSizeCommand}"
                            CommandParameter="14"
                            Classes="segmented-text"
                            Background="#252528"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Padding="8,4"/>
                    <Button Content="16"
                            Command="{Binding SetFontSizeCommand}"
                            CommandParameter="16"
                            Classes="segmented-text"
                            Background="#252528"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Padding="8,4"/>
                    <Button Content="+"
                            Command="{Binding IncreaseFontSizeCommand}"
                            Classes="segmented-text"
                            Background="#252528"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            FontWeight="Bold"
                            Padding="12,4"/>
                    <TextBlock Text="{Binding FontSize, StringFormat='{}{0} pt'}"
                               Foreground="{DynamicResource ThemeAccentBrush}"
                               FontWeight="Bold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                  </StackPanel>
                </StackPanel>

                <!-- Right: Tab Size -->
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Text="Tab Indentation"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ThemeWindowForeground}"
                             FontSize="13"/>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="2 spaces"
                            Command="{Binding SetTabSizeCommand}"
                            CommandParameter="2"
                            Classes="segmented-text"
                            Background="#252528"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Padding="10,4"/>
                    <Button Content="4 spaces"
                            Command="{Binding SetTabSizeCommand}"
                            CommandParameter="4"
                            Classes="segmented-text"
                            Background="#252528"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Padding="10,4"/>
                    <Button Content="8 spaces"
                            Command="{Binding SetTabSizeCommand}"
                            CommandParameter="8"
                            Classes="segmented-text"
                            Background="#252528"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Padding="10,4"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- 3. Live Font & Text Preview Card -->
            <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0"
                             Text="Live Font Preview"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ThemeWindowForeground}"
                             FontSize="13"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding SelectedFont}"
                             FontSize="11"
                             Foreground="{DynamicResource ThemeAccentBrush}"/>
                </Grid>

                <Border Background="{DynamicResource ThemeEditorBackground}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                  <StackPanel Spacing="4">
                    <TextBlock Text="// Live coding font rendering test"
                               FontFamily="{Binding SelectedFontFamily}"
                               FontSize="{Binding FontSize}"
                               Foreground="#6A9955"/>
                    <TextBlock Text="public static void Main(string[] args) => Console.WriteLine(&quot;Hello, Code Viewer!&quot;);"
                               FontFamily="{Binding SelectedFontFamily}"
                               FontSize="{Binding FontSize}"
                               Foreground="{DynamicResource ThemeEditorForeground}"/>
                    <TextBlock Text="const double pi = 3.1415926535; var items = new List&lt;int&gt; { 1, 2, 3 };"
                               FontFamily="{Binding SelectedFontFamily}"
                               FontSize="{Binding FontSize}"
                               Foreground="{DynamicResource ThemeEditorForeground}"/>
                    <TextBlock Text="0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz == &gt;= != &lt;="
                               FontFamily="{Binding SelectedFontFamily}"
                               FontSize="{Binding FontSize}"
                               Foreground="{DynamicResource ThemeAccentBrush}"
                               Opacity="0.85"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- 4. Editor Behaviors Card -->
            <Border Classes="settings-card">
              <StackPanel Spacing="12">
                <TextBlock Text="Editor Behaviors &amp; Rendering"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeWindowForeground}"
                           FontSize="14"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                  <CheckBox Grid.Row="0" Grid.Column="0"
                            IsChecked="{Binding SmoothCursorBlink}"
                            Content="Smooth cursor breathing (~60fps)"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Margin="0,4"/>
                  <CheckBox Grid.Row="0" Grid.Column="1"
                            IsChecked="{Binding SmoothScrolling}"
                            Content="Silky-smooth mouse scrolling"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Margin="0,4"/>

                  <CheckBox Grid.Row="1" Grid.Column="0"
                            IsChecked="{Binding HighlightCurrentLine}"
                            Content="Highlight active cursor line"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Margin="0,4"/>
                  <CheckBox Grid.Row="1" Grid.Column="1"
                            IsChecked="{Binding EnableBracketMatching}"
                            Content="Highlight bracket pairs () [] {}"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Margin="0,4"/>

                  <CheckBox Grid.Row="2" Grid.Column="0"
                            IsChecked="{Binding ShowWhitespace}"
                            Content="Show whitespace (spaces &amp; tabs)"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Margin="0,4"/>
                  <CheckBox Grid.Row="2" Grid.Column="1"
                            IsChecked="{Binding HighlightWordOccurrences}"
                            Content="Highlight word occurrences"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Margin="0,4"/>

                  <CheckBox Grid.Row="3" Grid.Column="0"
                            IsChecked="{Binding ShowLineNumbers}"
                            Content="Show gutter line numbers"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Margin="0,4"/>
                  <CheckBox Grid.Row="3" Grid.Column="1"
                            IsChecked="{Binding WordWrap}"
                            Content="Enable soft word wrap"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Margin="0,4"/>

                  <CheckBox Grid.Row="4" Grid.Column="0"
                            IsChecked="{Binding AutoCloseBrackets}"
                            Content="Auto-close brackets &amp; quotes () [] {} &quot;&quot; ''"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Margin="0,4"/>
                  <CheckBox Grid.Row="4" Grid.Column="1"
                            IsChecked="{Binding EnableRainbowBrackets}"
                            Content="Rainbow bracket pair colorization"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Margin="0,4"/>

                  <CheckBox Grid.Row="5" Grid.Column="0"
                            IsChecked="{Binding ShowBreadcrumbs}"
                            Content="Show breadcrumbs bar above editor"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Margin="0,4"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ========================================== -->
      <!-- TAB 2: Theme Gallery & Appearance          -->
      <!-- ========================================== -->
      <TabItem Header="🎨 Theme Gallery">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="4,12,8,12">
            <!-- Appearance Controls -->
            <Border Classes="settings-card">
              <Grid ColumnDefinitions="*,Auto,24,*,Auto">
                <!-- Theme Mode -->
                <TextBlock Grid.Column="0"
                           Text="Appearance Mode"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeWindowForeground}"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="1"
                        Background="{DynamicResource ThemeWindowBackground}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="2">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Command="{Binding SetThemeModeCommand}"
                            CommandParameter="System"
                            Classes="segmented"
                            Classes.active="{Binding IsSystemTheme}"
                            ToolTip.Tip="System / OS Default">
                      <TextBlock Text="💻 System" FontSize="11" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding SetThemeModeCommand}"
                            CommandParameter="Dark"
                            Classes="segmented"
                            Classes.active="{Binding IsDarkTheme}"
                            ToolTip.Tip="Dark Theme">
                      <TextBlock Text="🌙 Dark" FontSize="11" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding SetThemeModeCommand}"
                            CommandParameter="Light"
                            Classes="segmented"
                            Classes.active="{Binding IsLightTheme}"
                            ToolTip.Tip="Light Theme">
                      <TextBlock Text="☀️ Light" FontSize="11" VerticalAlignment="Center"/>
                    </Button>
                  </StackPanel>
                </Border>

                <!-- Contrast -->
                <TextBlock Grid.Column="3"
                           Text="Contrast"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeWindowForeground}"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="4"
                        Background="{DynamicResource ThemeWindowBackground}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="2">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Command="{Binding SetContrastModeCommand}"
                            CommandParameter="Default"
                            Classes="segmented-text"
                            Classes.active="{Binding IsDefaultContrast}"
                            Content="Default"/>
                    <Button Command="{Binding SetContrastModeCommand}"
                            CommandParameter="Strong"
                            Classes="segmented-text"
                            Classes.active="{Binding IsStrongContrast}"
                            Content="Strong"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <!-- Interactive Theme Gallery -->
            <Border Classes="settings-card">
              <StackPanel Spacing="12">
                <!-- Filter Bar & Actions -->
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Content="All Themes"
                            Command="{Binding SetThemeFilterCommand}"
                            CommandParameter="All"
                            Classes="segmented-text"
                            Classes.active="{Binding IsAllThemeFilter}"/>
                    <Button Content="🌙 Dark"
                            Command="{Binding SetThemeFilterCommand}"
                            CommandParameter="Dark"
                            Classes="segmented-text"
                            Classes.active="{Binding IsDarkThemeFilter}"/>
                    <Button Content="☀️ Light"
                            Command="{Binding SetThemeFilterCommand}"
                            CommandParameter="Light"
                            Classes="segmented-text"
                            Classes.active="{Binding IsLightThemeFilter}"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="➕ Import Theme (.json)..."
                            Command="{Binding ImportThemeCommand}"
                            Classes="segmented-text"
                            Background="#252528"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Padding="10,5"/>
                    <Button Content="📁 Open Themes Folder"
                            Command="{Binding OpenThemesFolderCommand}"
                            Classes="segmented-text"
                            Background="#252528"
                            Foreground="{DynamicResource ThemeWindowForeground}"
                            Padding="10,5"/>
                  </StackPanel>
                </Grid>

                <TextBlock Text="Click any theme below to activate it instantly across Code Viewer:"
                           FontSize="11"
                           Foreground="#888888"/>

                <!-- Theme Cards List -->
                <ItemsControl ItemsSource="{Binding FilteredThemes}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:ColorTheme">
                      <Button Classes="theme-card-btn"
                              Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).SelectThemeFromGalleryCommand}"
                              CommandParameter="{Binding}"
                              Margin="4">
                        <StackPanel Spacing="8">
                          <!-- Top row: Name & Tag -->
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeWindowForeground}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1"
                                    Background="#303038"
                                    CornerRadius="3"
                                    Padding="5,1">
                              <TextBlock Text="{Binding IsDark, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue='DARK'}"
                                         FontSize="9"
                                         FontWeight="Bold"
                                         Foreground="#888888"/>
                            </Border>
                          </Grid>

                          <!-- Bottom row: Color Chips -->
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="16" Height="16" CornerRadius="8" Background="{Binding EditorBackgroundBrush}" BorderBrush="#555555" BorderThickness="1" ToolTip.Tip="Editor Background"/>
                            <Border Width="16" Height="16" CornerRadius="8" Background="{Binding AccentBrush}" BorderBrush="#555555" BorderThickness="1" ToolTip.Tip="Accent Color"/>
                            <Border Width="16" Height="16" CornerRadius="8" Background="{Binding KeywordBrush}" BorderBrush="#555555" BorderThickness="1" ToolTip.Tip="Keywords"/>
                            <Border Width="16" Height="16" CornerRadius="8" Background="{Binding StringBrush}" BorderBrush="#555555" BorderThickness="1" ToolTip.Tip="Strings"/>
                            <TextBlock Text="{Binding Id}"
                                       FontSize="10"
                                       Foreground="#666666"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ========================================== -->
      <!-- TAB 3: Code Colors (Syntax Highlighting)  -->
      <!-- ========================================== -->
      <TabItem Header="🌈 Code Colors">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="4,12,8,12">
            <!-- Syntax Customizer Card -->
            <Border Classes="settings-card">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Custom Syntax Highlighting Colors"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeWindowForeground}"
                               FontSize="14"/>
                    <TextBlock Text="Override token colors for all programming languages. Leave blank or click Reset to use the active theme defaults."
                               FontSize="11"
                               Foreground="#888888"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="↺ Reset to Theme Defaults"
                          Command="{Binding ResetSyntaxColorsCommand}"
                          Classes="segmented-text"
                          Background="#252528"
                          Foreground="{DynamicResource ThemeWindowForeground}"
                          Padding="10,5"/>
                </Grid>

                <!-- Token Editor Grid (8 items in 2 columns) -->
                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,6">
                  <!-- 1. Keywords -->
                  <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" Background="{Binding KeywordBrush}" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Keywords" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="if, while, class, return, async" Foreground="#777" FontSize="10"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" Width="95" Text="{Binding CustomCodeKeyword, Mode=TwoWay}" Watermark="#569CD6" FontSize="11" VerticalContentAlignment="Center"/>
                  </Grid>

                  <!-- 2. Comments -->
                  <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" Background="{Binding CommentBrush}" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Comments" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="// Single &amp; /* multi */ comments" Foreground="#777" FontSize="10"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" Width="95" Text="{Binding CustomCodeComment, Mode=TwoWay}" Watermark="#6A9955" FontSize="11" VerticalContentAlignment="Center"/>
                  </Grid>

                  <!-- 3. Strings -->
                  <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" Background="{Binding StringBrush}" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Strings &amp; Literals" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="&quot;hello&quot;, 'c', regex" Foreground="#777" FontSize="10"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" Width="95" Text="{Binding CustomCodeString, Mode=TwoWay}" Watermark="#CE9178" FontSize="11" VerticalContentAlignment="Center"/>
                  </Grid>

                  <!-- 4. Numbers -->
                  <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" Background="{Binding NumberBrush}" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Numbers &amp; Digits" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="42, 3.14, 0xFF" Foreground="#777" FontSize="10"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" Width="95" Text="{Binding CustomCodeNumber, Mode=TwoWay}" Watermark="#B5CEA8" FontSize="11" VerticalContentAlignment="Center"/>
                  </Grid>

                  <!-- 5. Types -->
                  <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" Background="{Binding TypeBrush}" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Types &amp; Classes" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="List&lt;T&gt;, string, Window" Foreground="#777" FontSize="10"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" Width="95" Text="{Binding CustomCodeType, Mode=TwoWay}" Watermark="#4EC9B0" FontSize="11" VerticalContentAlignment="Center"/>
                  </Grid>

                  <!-- 6. Methods -->
                  <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" Background="{Binding MethodBrush}" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Methods &amp; Calls" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="WriteLine(), Calculate()" Foreground="#777" FontSize="10"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" Width="95" Text="{Binding CustomCodeMethod, Mode=TwoWay}" Watermark="#DCDCAA" FontSize="11" VerticalContentAlignment="Center"/>
                  </Grid>

                  <!-- 7. Preprocessors -->
                  <Grid Grid.Row="3" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" Background="{Binding PreprocessorBrush}" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Preprocessors" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="#region, #if, import" Foreground="#777" FontSize="10"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" Width="95" Text="{Binding CustomCodePreprocessor, Mode=TwoWay}" Watermark="#9B9B9B" FontSize="11" VerticalContentAlignment="Center"/>
                  </Grid>

                  <!-- 8. Punctuation -->
                  <Grid Grid.Row="3" Grid.Column="2" ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" Background="{Binding PunctuationBrush}" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Punctuation" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text=";, ., {}, [], ()" Foreground="#777" FontSize="10"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" Width="95" Text="{Binding CustomCodePunctuation, Mode=TwoWay}" Watermark="#D4D4D4" FontSize="11" VerticalContentAlignment="Center"/>
                  </Grid>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Interactive Live Code Preview Card -->
            <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Text="Interactive Code Syntax Preview"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeWindowForeground}"
                           FontSize="13"/>

                <Border Background="{DynamicResource ThemeEditorBackground}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                  <StackPanel Spacing="3">
                    <TextBlock Text="// Syntax token colors preview live as you type or pick themes"
                               FontFamily="{Binding SelectedFontFamily}"
                               FontSize="{Binding FontSize}"
                               Foreground="{Binding CommentBrush}"/>

                    <TextBlock Text="#region GeometryCalculationEngine"
                               FontFamily="{Binding SelectedFontFamily}"
                               FontSize="{Binding FontSize}"
                               Foreground="{Binding PreprocessorBrush}"/>

                    <StackPanel Orientation="Horizontal" Spacing="0">
                      <TextBlock Text="public " FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding KeywordBrush}"/>
                      <TextBlock Text="class " FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding KeywordBrush}"/>
                      <TextBlock Text="Calculator" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding TypeBrush}"/>
                      <TextBlock Text="&lt;" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding PunctuationBrush}"/>
                      <TextBlock Text="T" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding TypeBrush}"/>
                      <TextBlock Text="&gt;" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding PunctuationBrush}"/>
                    </StackPanel>

                    <TextBlock Text="{}{" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding PunctuationBrush}"/>

                    <StackPanel Orientation="Horizontal" Spacing="0">
                      <TextBlock Text="    public const double " FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding KeywordBrush}"/>
                      <TextBlock Text="Scale " FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{DynamicResource ThemeEditorForeground}"/>
                      <TextBlock Text="= " FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding PunctuationBrush}"/>
                      <TextBlock Text="3.14159" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding NumberBrush}"/>
                      <TextBlock Text=";" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding PunctuationBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="0">
                      <TextBlock Text="    public string " FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding KeywordBrush}"/>
                      <TextBlock Text="FormatResult" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding MethodBrush}"/>
                      <TextBlock Text="(" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding PunctuationBrush}"/>
                      <TextBlock Text="int " FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding KeywordBrush}"/>
                      <TextBlock Text="count" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{DynamicResource ThemeEditorForeground}"/>
                      <TextBlock Text=") =&gt; " FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding PunctuationBrush}"/>
                      <TextBlock Text="&quot;Items: &quot;" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding StringBrush}"/>
                      <TextBlock Text=" + count;" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding PunctuationBrush}"/>
                    </StackPanel>

                    <TextBlock Text="}" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding PunctuationBrush}"/>

                    <TextBlock Text="#endregion"
                               FontFamily="{Binding SelectedFontFamily}"
                               FontSize="{Binding FontSize}"
                               Foreground="{Binding PreprocessorBrush}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ========================================== -->
      <!-- TAB 4: System & Updates                    -->
      <!-- ========================================== -->
      <TabItem Header="⚡ System &amp; Updates">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="4,12,8,12">
            <!-- Background Startup & Performance -->
            <Border Classes="settings-card">
              <StackPanel Spacing="12">
                <TextBlock Text="Startup &amp; Background Launch Mode"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeWindowForeground}"
                           FontSize="14"/>
                <TextBlock Text="Pre-warm Code Viewer in the background at Windows startup for sub-10ms instantaneous opening."
                           FontSize="11"
                           Foreground="#888888"/>

                <CheckBox IsChecked="{Binding RunInBackgroundOnStartup}"
                          Foreground="{DynamicResource ThemeWindowForeground}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Pre-load in background at Windows startup"
                               FontWeight="Medium"
                               Foreground="{DynamicResource ThemeWindowForeground}"/>
                    <TextBlock Text="Starts silently in tray; files open instantly without splash delay."
                               FontSize="11"
                               Foreground="#888888"/>
                  </StackPanel>
                </CheckBox>

                <CheckBox IsChecked="{Binding MinimizeToTrayOnClose}"
                          Foreground="{DynamicResource ThemeWindowForeground}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Minimize to system tray on window close"
                               FontWeight="Medium"
                               Foreground="{DynamicResource ThemeWindowForeground}"/>
                    <TextBlock Text="Keeps the app pre-warmed in background memory for instant reopening."
                               FontSize="11"
                               Foreground="#888888"/>
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </Border>

            <!-- Software Updates -->
            <Border Classes="settings-card">
              <StackPanel Spacing="12">
                <TextBlock Text="Software Updates"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeWindowForeground}"
                           FontSize="14"/>
                <TextBlock Text="Keep Code Viewer up to date with official releases and security improvements."
                           FontSize="11"
                           Foreground="#888888"/>

                <CheckBox IsChecked="{Binding AutoCheckForUpdates}"
                          Foreground="{DynamicResource ThemeWindowForeground}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Automatically check for updates on startup"
                               FontWeight="Medium"
                               Foreground="{DynamicResource ThemeWindowForeground}"/>
                    <TextBlock Text="Checks GitHub Releases unobtrusively in the background and notifies you when an update is available."
                               FontSize="11"
                               Foreground="#888888"/>
                  </StackPanel>
                </CheckBox>

                <Button Content="Check for Updates Now..."
                        Command="{Binding CheckForUpdatesNowCommand}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource ThemeSelectionBackground}"
                        Foreground="{DynamicResource ThemeWindowForeground}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,6"
                        Cursor="Hand"
                        Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Bottom Action Bar -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,16,0,0">
      <Button Grid.Column="0"
              Content="Reset Defaults"
              Command="{Binding ResetDefaultsCommand}"
              Background="#333333"
              Foreground="{DynamicResource ThemeWindowForeground}"
              CornerRadius="5"
              Padding="14,6"/>

      <Button Grid.Column="2"
              Content="Cancel"
              Command="{Binding CancelCommand}"
              Background="Transparent"
              Foreground="{DynamicResource ThemeWindowForeground}"
              BorderBrush="#555555"
              BorderThickness="1"
              CornerRadius="5"
              Width="85"
              HorizontalContentAlignment="Center"
              Padding="12,6"/>

      <Button Grid.Column="4"
              Content="Save &amp; Apply"
              Command="{Binding SaveCommand}"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="#FFFFFF"
              FontWeight="SemiBold"
              CornerRadius="5"
              Width="120"
              HorizontalContentAlignment="Center"
              Padding="12,6"/>
    </Grid>
  </Grid>
</Window>
