<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodeViewer.ViewModels"
        xmlns:models="using:CodeViewer.Models"
        x:Class="CodeViewer.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="Settings - Code Viewer"
        Icon="/Assets/icon.png"
        Width="680" Height="580"
        MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBackground}">

  <Window.Styles>
    <Style Selector="Button.segmented">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#888888"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.segmented:pointerover">
      <Setter Property="Background" Value="#2E2E32"/>
      <Setter Property="Foreground" Value="#CCCCCC"/>
    </Style>
    <Style Selector="Button.segmented.active">
      <Setter Property="Background" Value="#3F3F46"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button.segmented-text">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#888888"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.segmented-text:pointerover">
      <Setter Property="Background" Value="#2E2E32"/>
      <Setter Property="Foreground" Value="#CCCCCC"/>
    </Style>
    <Style Selector="Button.segmented-text.active">
      <Setter Property="Background" Value="#3F3F46"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.theme-card">
      <Setter Property="Background" Value="{DynamicResource ThemeTabBarBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style Selector="Border.hex-box">
      <Setter Property="Background" Value="{DynamicResource ThemeWindowBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Width" Value="150"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
  </Window.Styles>

  <Grid Margin="22" RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Settings &amp; Preferences"
                 FontSize="20"
                 FontWeight="Bold"
                 Foreground="{DynamicResource ThemeWindowForeground}"/>
      <TextBlock Text="Customize editor fonts, theme colors, syntax highlighting, and editor behavior."
                 FontSize="12"
                 Foreground="#888888"
                 Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Tabbed Settings Content -->
    <TabControl Grid.Row="1">
      <!-- Tab 1: Fonts & Editor -->
      <TabItem Header="Editor &amp; Fonts">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="4,12,8,12">
            <!-- Font Family -->
            <Border Background="{DynamicResource ThemeTabBarBackground}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
              <StackPanel Spacing="8">
                <TextBlock Text="Font Family"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeWindowForeground}"
                           FontSize="13"/>
                <TextBlock Text="Select a coding font or type custom font name installed on your system."
                           FontSize="11"
                           Foreground="#888888"/>
                <ComboBox ItemsSource="{Binding AvailableFonts}"
                          SelectedItem="{Binding SelectedFont}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}"
                                 FontFamily="{Binding}"
                                 FontSize="13"
                                 VerticalAlignment="Center"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Text="{Binding SelectedFont}"
                         Watermark="Or type custom font family name..."
                         Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <!-- Font Size -->
            <Border Background="{DynamicResource ThemeTabBarBackground}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                  <TextBlock Text="Font Size"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ThemeWindowForeground}"
                             FontSize="13"/>
                  <TextBlock Text="Adjust editor text size (8 pt to 36 pt)."
                             FontSize="11"
                             Foreground="#888888"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Grid.Row="0"
                           Text="{Binding FontSize, StringFormat='{}{0:0} pt'}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ThemeAccentBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <Slider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="0,8,0,0"
                        Minimum="8" Maximum="36"
                        Value="{Binding FontSize}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"/>
              </Grid>
            </Border>

            <!-- Editor Options Grid: Word Wrap, Line Numbers, Tab Size -->
            <Border Background="{DynamicResource ThemeTabBarBackground}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
              <StackPanel Spacing="12">
                <TextBlock Text="Editor Display Options"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeWindowForeground}"
                           FontSize="13"/>

                <CheckBox IsChecked="{Binding ShowLineNumbers}"
                          Content="Show line numbers in editor gutter"
                          Foreground="{DynamicResource ThemeWindowForeground}"/>

                <CheckBox IsChecked="{Binding WordWrap}"
                          Content="Enable word wrap by default"
                          Foreground="{DynamicResource ThemeWindowForeground}"/>

                <CheckBox IsChecked="{Binding RestorePreviousSession}"
                          Content="Restore previously opened tabs on startup"
                          Foreground="{DynamicResource ThemeWindowForeground}"/>

                <Grid ColumnDefinitions="Auto,12,100" Margin="0,4,0,0">
                  <TextBlock Grid.Column="0"
                             Text="Tab Size (spaces):"
                             Foreground="{DynamicResource ThemeWindowForeground}"
                             VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="2"
                            ItemsSource="{Binding AvailableTabSizes}"
                            SelectedItem="{Binding TabSize}"
                            HorizontalAlignment="Stretch"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 2: Theme & Appearance -->
      <TabItem Header="Theme">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="4,12,8,12">

            <!-- 1. Appearance Section -->
            <StackPanel Spacing="8">
              <TextBlock Text="Appearance"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ThemeWindowForeground}"
                         FontSize="14"/>
              
              <Border Classes="theme-card">
                <StackPanel Spacing="12">
                  <!-- Row: Theme -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Theme"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeWindowForeground}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            Background="{DynamicResource ThemeWindowBackground}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Command="{Binding SetThemeModeCommand}"
                                CommandParameter="System"
                                Classes="segmented"
                                Classes.active="{Binding IsSystemTheme}"
                                ToolTip.Tip="System / OS Default (💻)">
                          <TextBlock Text="💻" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                        <Button Command="{Binding SetThemeModeCommand}"
                                CommandParameter="Light"
                                Classes="segmented"
                                Classes.active="{Binding IsLightTheme}"
                                ToolTip.Tip="Light Theme (☀️)">
                          <TextBlock Text="☀️" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                        <Button Command="{Binding SetThemeModeCommand}"
                                CommandParameter="Dark"
                                Classes="segmented"
                                Classes.active="{Binding IsDarkTheme}"
                                ToolTip.Tip="Dark Theme (🌙)">
                          <TextBlock Text="🌙" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Row: Contrast -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Contrast"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeWindowForeground}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            Background="{DynamicResource ThemeWindowBackground}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Command="{Binding SetContrastModeCommand}"
                                CommandParameter="Default"
                                Classes="segmented-text"
                                Classes.active="{Binding IsDefaultContrast}"
                                Content="Default"/>
                        <Button Command="{Binding SetContrastModeCommand}"
                                CommandParameter="Strong"
                                Classes="segmented-text"
                                Classes.active="{Binding IsStrongContrast}"
                                Content="Strong"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 2. Light Theme Section -->
            <StackPanel Spacing="8">
              <TextBlock Text="Light Theme"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ThemeWindowForeground}"
                         FontSize="14"/>

              <Border Classes="theme-card">
                <StackPanel Spacing="10">
                  <!-- Row: Preset -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Preset"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeWindowForeground}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableLightThemes}"
                              SelectedItem="{Binding SelectedLightPreset}"
                              Width="180"
                              CornerRadius="5">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ColorTheme">
                          <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>

                  <!-- Row: Background -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Background"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeWindowForeground}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Classes="hex-box">
                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0"
                                Width="14" Height="14"
                                CornerRadius="3"
                                Background="{Binding LightBackgroundBrush}"
                                BorderBrush="#666666"
                                BorderThickness="1"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="#"
                                   Foreground="#888888"
                                   FontSize="12"
                                   FontFamily="Consolas, Cascadia Code, Monospace"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding LightBackgroundHex}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontSize="12"
                                 FontFamily="Consolas, Cascadia Code, Monospace"
                                 VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </Grid>

                  <!-- Row: Foreground -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Foreground"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeWindowForeground}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Classes="hex-box">
                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0"
                                Width="14" Height="14"
                                CornerRadius="3"
                                Background="{Binding LightForegroundBrush}"
                                BorderBrush="#666666"
                                BorderThickness="1"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="#"
                                   Foreground="#888888"
                                   FontSize="12"
                                   FontFamily="Consolas, Cascadia Code, Monospace"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding LightForegroundHex}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontSize="12"
                                 FontFamily="Consolas, Cascadia Code, Monospace"
                                 VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </Grid>

                  <!-- Row: Accent -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Accent"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeWindowForeground}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Classes="hex-box">
                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0"
                                Width="14" Height="14"
                                CornerRadius="3"
                                Background="{Binding LightAccentBrush}"
                                BorderBrush="#666666"
                                BorderThickness="1"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="#"
                                   Foreground="#888888"
                                   FontSize="12"
                                   FontFamily="Consolas, Cascadia Code, Monospace"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding LightAccentHex}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontSize="12"
                                 FontFamily="Consolas, Cascadia Code, Monospace"
                                 VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 3. Dark Theme Section -->
            <StackPanel Spacing="8">
              <TextBlock Text="Dark Theme"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ThemeWindowForeground}"
                         FontSize="14"/>

              <Border Classes="theme-card">
                <StackPanel Spacing="10">
                  <!-- Row: Preset -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Preset"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeWindowForeground}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableDarkThemes}"
                              SelectedItem="{Binding SelectedDarkPreset}"
                              Width="180"
                              CornerRadius="5">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ColorTheme">
                          <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>

                  <!-- Row: Background -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Background"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeWindowForeground}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Classes="hex-box">
                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0"
                                Width="14" Height="14"
                                CornerRadius="3"
                                Background="{Binding DarkBackgroundBrush}"
                                BorderBrush="#666666"
                                BorderThickness="1"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="#"
                                   Foreground="#888888"
                                   FontSize="12"
                                   FontFamily="Consolas, Cascadia Code, Monospace"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding DarkBackgroundHex}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontSize="12"
                                 FontFamily="Consolas, Cascadia Code, Monospace"
                                 VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </Grid>

                  <!-- Row: Foreground -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Foreground"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeWindowForeground}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Classes="hex-box">
                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0"
                                Width="14" Height="14"
                                CornerRadius="3"
                                Background="{Binding DarkForegroundBrush}"
                                BorderBrush="#666666"
                                BorderThickness="1"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="#"
                                   Foreground="#888888"
                                   FontSize="12"
                                   FontFamily="Consolas, Cascadia Code, Monospace"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding DarkForegroundHex}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontSize="12"
                                 FontFamily="Consolas, Cascadia Code, Monospace"
                                 VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </Grid>

                  <!-- Row: Accent -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Accent"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeWindowForeground}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Classes="hex-box">
                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0"
                                Width="14" Height="14"
                                CornerRadius="3"
                                Background="{Binding DarkAccentBrush}"
                                BorderBrush="#666666"
                                BorderThickness="1"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="#"
                                   Foreground="#888888"
                                   FontSize="12"
                                   FontFamily="Consolas, Cascadia Code, Monospace"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding DarkAccentHex}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontSize="12"
                                 FontFamily="Consolas, Cascadia Code, Monospace"
                                 VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 3: Code Colors in Theme -->
      <TabItem Header="Code Colors">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="4,12,8,12">
            <Border Background="{DynamicResource ThemeTabBarBackground}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
              <StackPanel Spacing="10">
                <TextBlock Text="Syntax Highlighting Colors"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeWindowForeground}"
                           FontSize="13"/>
                <TextBlock Text="Active theme syntax highlighting colors applied to code tokens in the editor."
                           FontSize="11"
                           Foreground="#888888"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,6">
                  <!-- Keyword -->
                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,6">
                    <Border Width="20" Height="20" CornerRadius="4" Background="{Binding SelectedTheme.CodeKeyword}" BorderBrush="#444" BorderThickness="1"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Keywords" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SelectedTheme.CodeKeyword}" Foreground="#888888" FontSize="10"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- Comment -->
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,6">
                    <Border Width="20" Height="20" CornerRadius="4" Background="{Binding SelectedTheme.CodeComment}" BorderBrush="#444" BorderThickness="1"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Comments" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SelectedTheme.CodeComment}" Foreground="#888888" FontSize="10"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- String -->
                  <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,6">
                    <Border Width="20" Height="20" CornerRadius="4" Background="{Binding SelectedTheme.CodeString}" BorderBrush="#444" BorderThickness="1"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Strings" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SelectedTheme.CodeString}" Foreground="#888888" FontSize="10"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- Number -->
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,6">
                    <Border Width="20" Height="20" CornerRadius="4" Background="{Binding SelectedTheme.CodeNumber}" BorderBrush="#444" BorderThickness="1"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Numbers &amp; Digits" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SelectedTheme.CodeNumber}" Foreground="#888888" FontSize="10"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- Type / Class -->
                  <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,6">
                    <Border Width="20" Height="20" CornerRadius="4" Background="{Binding SelectedTheme.CodeType}" BorderBrush="#444" BorderThickness="1"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Types &amp; Classes" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SelectedTheme.CodeType}" Foreground="#888888" FontSize="10"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- Method / Function -->
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,6">
                    <Border Width="20" Height="20" CornerRadius="4" Background="{Binding SelectedTheme.CodeMethod}" BorderBrush="#444" BorderThickness="1"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Methods &amp; Calls" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SelectedTheme.CodeMethod}" Foreground="#888888" FontSize="10"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- Preprocessor -->
                  <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,6">
                    <Border Width="20" Height="20" CornerRadius="4" Background="{Binding SelectedTheme.CodePreprocessor}" BorderBrush="#444" BorderThickness="1"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Preprocessors" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SelectedTheme.CodePreprocessor}" Foreground="#888888" FontSize="10"/>
                    </StackPanel>
                  </StackPanel>

                  <!-- Punctuation -->
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,6">
                    <Border Width="20" Height="20" CornerRadius="4" Background="{Binding SelectedTheme.CodePunctuation}" BorderBrush="#444" BorderThickness="1"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Punctuation" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SelectedTheme.CodePunctuation}" Foreground="#888888" FontSize="10"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Live Syntax Sample Preview Box -->
            <Border Background="{Binding SelectedTheme.EditorBackground}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
              <StackPanel Spacing="6">
                <TextBlock Text="// Code Viewer Live Syntax &amp; Font Preview"
                           Foreground="{Binding SelectedTheme.CodeComment}"
                           FontFamily="{Binding SelectedFont}"
                           FontSize="{Binding FontSize}"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="public class"
                             Foreground="{Binding SelectedTheme.CodeKeyword}"
                             FontFamily="{Binding SelectedFont}"
                             FontSize="{Binding FontSize}"/>
                  <TextBlock Text="Calculator"
                             Foreground="{Binding SelectedTheme.CodeType}"
                             FontFamily="{Binding SelectedFont}"
                             FontSize="{Binding FontSize}"/>
                  <TextBlock Text="{}{"
                             Foreground="{Binding SelectedTheme.CodePunctuation}"
                             FontFamily="{Binding SelectedFont}"
                             FontSize="{Binding FontSize}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="16,0,0,0">
                  <TextBlock Text="public int"
                             Foreground="{Binding SelectedTheme.CodeKeyword}"
                             FontFamily="{Binding SelectedFont}"
                             FontSize="{Binding FontSize}"/>
                  <TextBlock Text="Calculate"
                             Foreground="{Binding SelectedTheme.CodeMethod}"
                             FontFamily="{Binding SelectedFont}"
                             FontSize="{Binding FontSize}"/>
                  <TextBlock Text="(string mode, int count = "
                             Foreground="{Binding SelectedTheme.Foreground}"
                             FontFamily="{Binding SelectedFont}"
                             FontSize="{Binding FontSize}"/>
                  <TextBlock Text="42"
                             Foreground="{Binding SelectedTheme.CodeNumber}"
                             FontFamily="{Binding SelectedFont}"
                             FontSize="{Binding FontSize}"/>
                  <TextBlock Text=")"
                             Foreground="{Binding SelectedTheme.CodePunctuation}"
                             FontFamily="{Binding SelectedFont}"
                             FontSize="{Binding FontSize}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="32,0,0,0">
                  <TextBlock Text="return"
                             Foreground="{Binding SelectedTheme.CodeKeyword}"
                             FontFamily="{Binding SelectedFont}"
                             FontSize="{Binding FontSize}"/>
                  <TextBlock Text="count;"
                             Foreground="{Binding SelectedTheme.Foreground}"
                             FontFamily="{Binding SelectedFont}"
                             FontSize="{Binding FontSize}"/>
                </StackPanel>
                <TextBlock Text="{}}"
                           Foreground="{Binding SelectedTheme.CodePunctuation}"
                           FontFamily="{Binding SelectedFont}"
                           FontSize="{Binding FontSize}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Bottom Action Bar -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,16,0,0">
      <Button Grid.Column="0"
              Content="Reset Defaults"
              Command="{Binding ResetDefaultsCommand}"
              Background="#333333"
              Foreground="{DynamicResource ThemeWindowForeground}"
              CornerRadius="5"
              Padding="12,6"/>

      <Button Grid.Column="2"
              Content="Cancel"
              Command="{Binding CancelCommand}"
              Background="Transparent"
              Foreground="{DynamicResource ThemeWindowForeground}"
              BorderBrush="#555555"
              BorderThickness="1"
              CornerRadius="5"
              Width="80"
              HorizontalContentAlignment="Center"
              Padding="12,6"/>

      <Button Grid.Column="4"
              Content="Save &amp; Apply"
              Command="{Binding SaveCommand}"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="#FFFFFF"
              FontWeight="SemiBold"
              CornerRadius="5"
              Width="110"
              HorizontalContentAlignment="Center"
              Padding="12,6"/>
    </Grid>
  </Grid>
</Window>
