<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:plugins="using:CodeViewer.Plugins"
        x:Class="CodeViewer.Views.PluginManagerDialog"
        Title="Plugin &amp; Tools Manager"
        Width="580" Height="460"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBackground}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Installed Plugins &amp; Tools"
                 FontSize="18"
                 FontWeight="Bold"
                 Foreground="{DynamicResource ThemeWindowForeground}"/>
      <TextBlock Text="Built-in developer utilities and dynamically imported assemblies."
                 FontSize="12"
                 Foreground="#888888"
                 Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Plugin List -->
    <Border Grid.Row="1"
            Background="{DynamicResource ThemeTabBarBackground}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
      <ListBox x:Name="PluginsList"
               Background="Transparent"
               SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="plugins:IPlugin">
            <Border Padding="10,8" Margin="0,2" Background="{DynamicResource ThemeTabItemInactiveBackground}" CornerRadius="3">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeWindowForeground}" FontSize="13"/>
                  <Border Background="{DynamicResource ThemeAccentBrush}" CornerRadius="3" Padding="5,1">
                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#FFFFFF"/>
                  </Border>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding Version, StringFormat='v{0}'}"
                           FontSize="11"
                           Foreground="#888888"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Description}"
                           FontSize="11"
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Bottom Action Bar -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
      <Button Grid.Column="0"
              Content="Open Plugins Folder"
              Click="OnOpenFolderClick"
              Background="#3C3C3C"
              Foreground="{DynamicResource ThemeWindowForeground}"
              Padding="12,6"/>

      <Button Grid.Column="2"
              Content="Close"
              Click="OnCloseClick"
              Width="80"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="#FFFFFF"
              HorizontalContentAlignment="Center"
              Padding="12,6"/>
    </Grid>
  </Grid>
</Window>
