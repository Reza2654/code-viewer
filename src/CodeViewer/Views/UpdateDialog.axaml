<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodeViewer.ViewModels"
        x:Class="CodeViewer.Views.UpdateDialog"
        x:DataType="vm:UpdateViewModel"
        Title="Code Viewer Update"
        Width="540" Height="480"
        WindowStartupLocation="CenterOwner"
        CanResize="false"
        Background="{DynamicResource ThemeWindowBackground}"
        Foreground="{DynamicResource ThemeWindowForeground}"
        ShowInTaskbar="false">

  <Grid Margin="24" RowDefinitions="Auto,*,Auto">
    <!-- Header Section -->
    <StackPanel Grid.Row="0" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center">
          <TextBlock Text="🚀" FontSize="20" Foreground="{DynamicResource ThemeAccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="A new update is available!"
                     FontSize="17"
                     FontWeight="Bold"
                     Foreground="{DynamicResource ThemeWindowForeground}"/>
          <TextBlock Text="{Binding ReleaseTitle}"
                     FontSize="12"
                     Foreground="{DynamicResource ThemeTabItemInactiveForeground}"/>
        </StackPanel>
      </StackPanel>

      <!-- Version Badges -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <Border Background="{DynamicResource ThemeTabBarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Installed:" FontSize="11" Foreground="{DynamicResource ThemeTabItemInactiveForeground}"/>
            <TextBlock Text="{Binding CurrentVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeWindowForeground}"/>
          </StackPanel>
        </Border>

        <TextBlock Text="➜" FontSize="12" Foreground="{DynamicResource ThemeTabItemInactiveForeground}" VerticalAlignment="Center"/>

        <Border Background="#1B7F37" BorderBrush="#2EA043" BorderThickness="1" CornerRadius="4" Padding="8,4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Latest:" FontSize="11" Foreground="#DCFCE7"/>
            <TextBlock Text="{Binding LatestVersion}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource ThemeTabBarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4"
                IsVisible="{Binding SizeFormatted, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding SizeFormatted}" FontSize="11" Foreground="{DynamicResource ThemeTabItemInactiveForeground}"/>
        </Border>
      </StackPanel>
    </StackPanel>

    <!-- Release Notes ScrollArea -->
    <Border Grid.Row="1"
            Margin="0,16"
            Background="{DynamicResource ThemeEditorBackground}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock Text="{Binding ReleaseNotes}"
                   Foreground="{DynamicResource ThemeEditorForeground}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   FontFamily="{StaticResource UiFontFamily}"/>
      </ScrollViewer>
    </Border>

    <!-- Footer Controls -->
    <StackPanel Grid.Row="2" Spacing="10">
      <!-- Download Progress Bar -->
      <StackPanel Spacing="4" IsVisible="{Binding IsDownloading}">
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Height="6" CornerRadius="3" Foreground="{DynamicResource ThemeAccentBrush}" Background="{DynamicResource ThemeTabItemInactiveBackground}"/>
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource ThemeTabItemInactiveForeground}" HorizontalAlignment="Right"/>
      </StackPanel>

      <!-- Error indicator -->
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="#E53935"
                 FontSize="11"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasError}"/>

      <!-- Buttons -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="0"
                Content="View on GitHub"
                Command="{Binding OpenReleasePageCommand}"
                Background="Transparent"
                Foreground="{DynamicResource ThemeAccentBrush}"
                BorderThickness="0"
                HorizontalAlignment="Left"
                Cursor="Hand"
                Padding="0"/>

        <Button Grid.Column="1"
                Content="Later"
                Command="{Binding CancelCommand}"
                Width="80"
                Margin="0,0,8,0"
                HorizontalContentAlignment="Center"
                Background="{DynamicResource ThemeTabItemInactiveBackground}"
                Foreground="{DynamicResource ThemeWindowForeground}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"/>

        <Button Grid.Column="2"
                Content="Update Now"
                Command="{Binding DownloadAndInstallCommand}"
                IsEnabled="{Binding !IsDownloading}"
                MinWidth="110"
                HorizontalContentAlignment="Center"
                Background="{DynamicResource ThemeAccentBrush}"
                Foreground="{DynamicResource ThemeAccentForeground}"
                FontWeight="SemiBold"
                CornerRadius="4"/>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
