<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CodeViewer.ViewModels"
             xmlns:models="using:CodeViewer.Models"
             x:Class="CodeViewer.Views.DiffView"
             x:DataType="vm:DiffViewModel"
             Background="{DynamicResource ThemeEditorBackground}">

  <UserControl.Styles>
    <Style Selector="Border.diff-added">
      <Setter Property="Background" Value="#252EA043"/>
    </Style>
    <Style Selector="Border.diff-removed">
      <Setter Property="Background" Value="#25DA3633"/>
    </Style>
    <Style Selector="Border.diff-unchanged">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- Diff Header Toolbar -->
    <Border Grid.Row="0"
            Background="{DynamicResource ThemeTabBarBackground}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="🔍 Diff Comparison" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeWindowForeground}" VerticalAlignment="Center"/>
          <Border Background="{DynamicResource ThemeSelectionBackground}" CornerRadius="4" Padding="6,2">
            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Original:" FontSize="11" Foreground="{DynamicResource ThemeStatusBarForeground}" Opacity="0.7"/>
            <TextBlock Text="{Binding OldTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeWindowForeground}"/>
          </StackPanel>
          <TextBlock Text="⇄" Foreground="{DynamicResource ThemeStatusBarForeground}" Opacity="0.5"/>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Modified:" FontSize="11" Foreground="{DynamicResource ThemeStatusBarForeground}" Opacity="0.7"/>
            <TextBlock Text="{Binding NewTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeWindowForeground}"/>
          </StackPanel>
        </StackPanel>

        <Button Grid.Column="3"
                Command="{Binding CloseDiffCommand}"
                ToolTip.Tip="Close Diff (Esc)"
                Width="24" Height="24"
                Padding="0"
                CornerRadius="4"
                Background="Transparent"
                BorderThickness="0">
          <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource ThemeStatusBarForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </Grid>
    </Border>

    <!-- Diff Lines Viewport -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding DiffLines}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="models:DiffLine">
            <Border Padding="4,1"
                    Classes.diff-added="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DiffLineType.Added}}"
                    Classes.diff-removed="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DiffLineType.Removed}}"
                    Classes.diff-unchanged="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DiffLineType.Unchanged}}">
              <Grid ColumnDefinitions="45,45,20,*">
                <!-- Old Line Number -->
                <TextBlock Grid.Column="0"
                           Text="{Binding OldLineNumber}"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="12"
                           TextAlignment="Right"
                           Foreground="{DynamicResource ThemeLineNumbersForeground}"
                           Opacity="0.6"
                           Margin="0,0,8,0"/>

                <!-- New Line Number -->
                <TextBlock Grid.Column="1"
                           Text="{Binding NewLineNumber}"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="12"
                           TextAlignment="Right"
                           Foreground="{DynamicResource ThemeLineNumbersForeground}"
                           Opacity="0.6"
                           Margin="0,0,8,0"/>

                <!-- Prefix (+ / - / space) -->
                <TextBlock Grid.Column="2"
                           Text="{Binding Prefix}"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ThemeWindowForeground}"
                           TextAlignment="Center"/>

                <!-- Line Text -->
                <TextBlock Grid.Column="3"
                           Text="{Binding Text}"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeEditorForeground}"
                           TextWrapping="NoWrap"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
