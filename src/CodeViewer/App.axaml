<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CodeViewer"
             x:Class="CodeViewer.App"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <local:ViewLocator/>
  </Application.DataTemplates>

  <Application.Resources>
    <!-- Dynamic Theme Resources (switched live by ThemeService) -->
    <SolidColorBrush x:Key="ThemeWindowBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ThemeWindowForeground" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ThemeMenuBackground" Color="#252526"/>
    <SolidColorBrush x:Key="ThemeMenuForeground" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ThemeTabBarBackground" Color="#252526"/>
    <SolidColorBrush x:Key="ThemeTabItemActiveBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ThemeTabItemInactiveBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ThemeTabItemActiveForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeTabItemInactiveForeground" Color="#969696"/>
    <SolidColorBrush x:Key="ThemeEditorBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ThemeEditorForeground" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ThemeLineNumbersForeground" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="ThemeSelectionBackground" Color="#264F78"/>
    <SolidColorBrush x:Key="ThemeStatusBarBackground" Color="#007ACC"/>
    <SolidColorBrush x:Key="ThemeStatusBarForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#181818"/>
    <FontFamily x:Key="CodeFontFamily">Google Sans Code, avares://CodeViewer/Assets/Fonts#Google Sans Code, Roboto Mono, avares://CodeViewer/Assets/Fonts#Roboto Mono, Cascadia Code, Consolas, Segoe UI, sans-serif</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <!-- Modern Dynamic Theme Palette Overrides -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource ThemeWindowBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeWindowForeground}"/>
      <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif"/>
    </Style>

    <!-- Menu Bar Styling -->
    <Style Selector="Menu">
      <Setter Property="Background" Value="{DynamicResource ThemeMenuBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeMenuForeground}"/>
      <Setter Property="Height" Value="30"/>
    </Style>

    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemeMenuForeground}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Custom Tab Styling with Rounded Corners and Micro-Transitions -->
    <Style Selector="Border.tabActive">
      <Setter Property="Background" Value="{DynamicResource ThemeTabItemActiveBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
      <Setter Property="BorderThickness" Value="0,2,0,0"/>
      <Setter Property="CornerRadius" Value="6,6,0,0"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.tabActive TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTabItemActiveForeground}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.tabInactive">
      <Setter Property="Background" Value="{DynamicResource ThemeTabItemInactiveBackground}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,2,0,0"/>
      <Setter Property="CornerRadius" Value="6,6,0,0"/>
      <Setter Property="Opacity" Value="0.82"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.tabInactive TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTabItemInactiveForeground}"/>
    </Style>

    <Style Selector="Border.tabInactive:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeTabBarBackground}"/>
      <Setter Property="Opacity" Value="1.0"/>
    </Style>

    <!-- Tab Close Button Micro-Interactions -->
    <Style Selector="Button.tab-close-btn">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.tab-close-btn:pointerover">
      <Setter Property="Background" Value="#35FF5252"/>
      <Setter Property="RenderTransform" Value="scale(1.15)"/>
    </Style>

    <Style Selector="Button.tab-close-btn:pointerover TextBlock">
      <Setter Property="Foreground" Value="#FF6B6B"/>
    </Style>

    <Style Selector="Button.tab-close-btn:pressed">
      <Setter Property="RenderTransform" Value="scale(0.92)"/>
    </Style>

    <!-- General Button Styling & Smooth Transitions -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>

    <!-- Status Bar Styling & Hover Transitions -->
    <Style Selector="Border.statusbar">
      <Setter Property="Background" Value="{DynamicResource ThemeStatusBarBackground}"/>
      <Setter Property="Height" Value="24"/>
    </Style>

    <Style Selector="Border.statusbar Button">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.statusbar Button:pointerover">
      <Setter Property="Background" Value="#25FFFFFF"/>
    </Style>

    <Style Selector="TextBlock.statusitem">
      <Setter Property="Foreground" Value="{DynamicResource ThemeStatusBarForeground}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="10,0,10,0"/>
    </Style>
  </Application.Styles>
</Application>
