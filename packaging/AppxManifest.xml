<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop desktop4 desktop5 com rescap">

  <Identity
    Name="CodeViewer.ModernShell"
    Publisher="CN=CodeViewer"
    Version="1.0.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Code Viewer</DisplayName>
    <PublisherDisplayName>Code Viewer</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application
      Id="CodeViewerApp"
      Executable="CodeViewer.exe"
      uap10:RuntimeBehavior="win32App"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="Code Viewer"
        Description="Fast, lightweight code viewer and editor"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- COM Server registration for IExplorerCommand -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Code Viewer Context Menu Handler">
              <com:Class
                Id="3D5D7BF0-2394-4B2D-86BE-8A6A2C29B7F1"
                Path="CodeViewer.ShellExtension.comhost.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!-- Windows 11 Modern Context Menu Verbs -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <!-- All files -->
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="OpenWithCodeViewer" Clsid="3D5D7BF0-2394-4B2D-86BE-8A6A2C29B7F1" />
            </desktop5:ItemType>
            <!-- Directory (Folders) -->
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="OpenWithCodeViewerDirectory" Clsid="3D5D7BF0-2394-4B2D-86BE-8A6A2C29B7F1" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
